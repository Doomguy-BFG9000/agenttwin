# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging and build artefacts
build/
dist/
*.egg-info/
.eggs/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Local secrets: the PyPI token lives in %USERPROFILE%\.pypirc, never here
.pypirc
.env

# pip scratch dirs, created when no usable TMPDIR exists on this machine
/pip-*/
/tmp*/

# Editors / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
# Internal design notes stay local; docs/ is the published GitHub Pages demo
notes/
